# ============================================================================
#  Variáveis de ambiente da APHAM
#  Copie este arquivo para ".env" (local) e configure as mesmas no Vercel.
#  NUNCA comite o .env com valores reais.
# ============================================================================

# --- Supabase (frontend — PÚBLICAS, podem ir no navegador) ---
# Painel do Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Mercado Pago (frontend — PÚBLICA) ---
# Mercado Pago > Suas integrações > Credenciais > Public Key
VITE_MP_PUBLIC_KEY=

# ============================================================================
#  As variáveis abaixo são SECRETAS e ficam só no servidor (Vercel >
#  Settings > Environment Variables). NÃO use o prefixo VITE_ nelas e não as
#  exponha no frontend.
# ============================================================================

# --- E-mail automático (Resend) ---
# resend.com > API Keys
RESEND_API_KEY=
# Para onde os e-mails de pedido/mensagem são enviados:
NOTIFY_EMAIL=apham.cvmf@gmail.com
# Remetente (precisa de domínio verificado no Resend; enquanto não tiver, use
# o onboarding@resend.dev para testes):
NOTIFY_FROM=APHAM <onboarding@resend.dev>

# --- Supabase (servidor — para o keep-alive) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Pagamento automático da loja (Mercado Pago) ---
# Access Token da aplicação (Credenciais) e a assinatura secreta dos Webhooks.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Chave service_role do Supabase (Settings > API): o servidor usa para registrar
# o pedido e confirmar o pagamento. NUNCA use no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: endereço do site para o aviso do Mercado Pago (padrão: o domínio acessado)
SITE_URL=https://www.handebolmarajo.org

# --- Frete automático (Melhor Envio — Correios) ---
# Token de acesso gerado no painel do Melhor Envio (permissão de cálculo de fretes).
# Sem ele, o frete para fora de Breves continua sendo calculado depois da compra.
MELHOR_ENVIO_TOKEN=
# Só para testes com uma conta do sandbox.melhorenvio.com.br (apague em produção):
MELHOR_ENVIO_SANDBOX=

# --- Instagram (Graph API) ---
# Token de acesso de longa duração + id da conta comercial do Instagram
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
